# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =======================================================
# 🐍 BACKEND (Python / Flask)
# =======================================================
# Ambiente virtual (VENV)
/backend/venv
/venv

# Arquivos de bytecode do Python
__pycache__/
*.pyc
*.pyo

# =======================================================
# ⚛️ FRONTEND (JavaScript / React)
# =======================================================
# Dependencies
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.js

# Build artifacts
/frontend/build
/frontend/dist
/frontend/out

# Testing
/frontend/coverage

# =======================================================
# 🔒 GERAL / SEGURANÇA / LOGS
# =======================================================
# Arquivos de Variáveis de Ambiente (que nunca devem ser versionados)
.env
/%USERPROFILE%

# Logs e Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.ideia
.ideia/
