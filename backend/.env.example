# ===============================================
# ARQUIVO DE AMBIENTE - MODELO (.env.example)
#
# Copie este arquivo para .env e preencha as credenciais.
# O .env deve ser ignorado pelo Git (.gitignore) por conter dados sensíveis.
# ===============================================

# --------------------
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO (Lidas pelo Flask e python-dotenv)
# --------------------
FLASK_APP=src.app:app  # O Flask procurará a instância 'app' dentro de 'src/app.py'
FLASK_ENV=development  # Modo que ativa o debugger e o recarregamento automático
PORT=5000              # Porta padrão para rodar o servidor Flask

# Chave secreta usada para assinar cookies de sessão e proteção CSRF.
# Mantenha esta chave longa e aleatória.
SECRET_KEY="SUA_CHAVE_SECRETA_ALEATORIA_PARA_SESSAO"


# ------------------------
# CONFIGURAÇÕES DO BANCO DE DADOS (MYSQL LOCALHOST)
# ------------------------
# Tipo de conexão (o conector é definido pelo driver 'mysql-connector-python' no requirements.txt)
DB_CONNECTION=mysql

# Host e Porta do servidor MySQL local (ex: se estiver rodando em Docker, pode ser o nome do serviço)
DB_HOST=127.0.0.1
DB_PORT=3307

# Nome do banco de dados (que o desenvolvedor deve criar vazio antes das migrações)
DB_NAME=ganesha_db

# Credenciais de acesso ao servidor MySQL
DB_USER=root
DB_PASSWORD=ganesha123